@prefix : <https://example.org/intonation-study#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/intonation-study> a owl:Ontology ;
    rdfs:label "Учебная модель тренажёра интонации"@ru ;
    rdfs:comment "Факты о каталоге и настройках взяты из исходного кода дипломного приложения; результатов пения здесь нет."@ru .

:ApplicationWithHistory a owl:Class ;
    rdfs:label "Приложение с историей"@ru ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Application [ a owl:Restriction ;
                        owl:onProperty :hasHistory ;
                        owl:someValuesFrom :History ] ) ] .

:ExerciseInCatalog a owl:Class ;
    rdfs:label "Упражнение в каталоге"@ru ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Exercise [ a owl:Restriction ;
                        owl:onProperty [ owl:inverseOf :hasExercise ] ;
                        owl:someValuesFrom :WarmupMode ] ) ] .

:ModeWithExercise a owl:Class ;
    rdfs:label "Режим с упражнениями"@ru ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :WarmupMode [ a owl:Restriction ;
                        owl:onProperty :hasExercise ;
                        owl:someValuesFrom :Exercise ] ) ] .

:PatternWithRoute a owl:Class ;
    rdfs:label "Паттерн с маршрутом"@ru ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Pattern [ a owl:Restriction ;
                        owl:onProperty :hasRoute ;
                        owl:someValuesFrom :Route ] ) ] .

:SetWithPattern a owl:Class ;
    rdfs:label "Набор с паттерном"@ru ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Set [ a owl:Restriction ;
                        owl:onProperty :hasPattern ;
                        owl:someValuesFrom :Pattern ] ) ] .

:durationMismatch a swrl:Imp ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 :var_e ;
                swrl:classPredicate :Exercise ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :var_e ;
                swrl:argument2 :var_actual ;
                swrl:propertyPredicate :durationSeconds ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :var_e ;
                swrl:argument2 :var_estimated ;
                swrl:propertyPredicate :estimatedDurationSeconds ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :var_actual :var_estimated ) ;
                swrl:builtin swrlb:notEqual ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 :var_e ;
                swrl:classPredicate :SuspiciousDescription ] ) .

:estimateDuration a swrl:Imp ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 :var_e ;
                swrl:classPredicate :Exercise ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :var_e ;
                swrl:argument2 :var_n ;
                swrl:propertyPredicate :noteCount ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :var_e ;
                swrl:argument2 :var_s ;
                swrl:propertyPredicate :secondsPerNote ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :var_d :var_n :var_s ) ;
                swrl:builtin swrlb:multiply ] ) ;
    swrl:head ( [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :var_e ;
                swrl:argument2 :var_d ;
                swrl:propertyPredicate :estimatedDurationSeconds ] ) .

:exerciseId a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasMode a owl:ObjectProperty ;
    rdfs:domain :Application ;
    rdfs:range :Mode .

:highestMidi a owl:DatatypeProperty ;
    rdfs:domain :Pattern ;
    rdfs:range xsd:integer .

:invalidNoteCount a swrl:Imp ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 :var_e ;
                swrl:classPredicate :Exercise ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :var_e ;
                swrl:argument2 :var_n ;
                swrl:propertyPredicate :noteCount ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :var_n 0 ) ;
                swrl:builtin swrlb:lessThanOrEqual ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 :var_e ;
                swrl:classPredicate :SuspiciousDescription ] ) .

:invalidPace a swrl:Imp ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 :var_e ;
                swrl:classPredicate :Exercise ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :var_e ;
                swrl:argument2 :var_s ;
                swrl:propertyPredicate :secondsPerNote ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :var_s 0 ) ;
                swrl:builtin swrlb:lessThanOrEqual ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 :var_e ;
                swrl:classPredicate :SuspiciousDescription ] ) .

:lowestMidi a owl:DatatypeProperty ;
    rdfs:domain :Pattern ;
    rdfs:range xsd:integer .

:rootAboveLimit a swrl:Imp ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 :var_r ;
                swrl:classPredicate :Route ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :var_r ;
                swrl:argument2 :var_m ;
                swrl:propertyPredicate :rootMidi ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :var_m 72 ) ;
                swrl:builtin swrlb:greaterThan ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 :var_r ;
                swrl:classPredicate :SuspiciousDescription ] ) .

:rootBelowLimit a swrl:Imp ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 :var_r ;
                swrl:classPredicate :Route ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :var_r ;
                swrl:argument2 :var_m ;
                swrl:propertyPredicate :rootMidi ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :var_m 36 ) ;
                swrl:builtin swrlb:lessThan ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 :var_r ;
                swrl:classPredicate :SuspiciousDescription ] ) .

:title a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:trainer a owl:NamedIndividual,
        :Application ;
    rdfs:label "Тренажёр интонации"@ru ;
    :hasHistory :localHistory ;
    :hasMode :live,
        :songs,
        :warmup .

:unsupportedClimb a swrl:Imp ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 :var_r ;
                swrl:classPredicate :Route ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 :var_r ;
                swrl:argument2 :var_c ;
                swrl:propertyPredicate :climbSemitones ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :var_c 0 ) ;
                swrl:builtin swrlb:notEqual ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :var_c 2 ) ;
                swrl:builtin swrlb:notEqual ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( :var_c 4 ) ;
                swrl:builtin swrlb:notEqual ] ) ;
    swrl:head ( [ a swrl:ClassAtom ;
                swrl:argument1 :var_r ;
                swrl:classPredicate :SuspiciousDescription ] ) .

:LiveMode a owl:Class ;
    rdfs:label "Живой голос"@ru ;
    rdfs:subClassOf :Mode .

:SongMode a owl:Class ;
    rdfs:label "Режим песен"@ru ;
    rdfs:subClassOf :Mode .

:ascendingRoute0 a owl:NamedIndividual,
        :Route ;
    :climbSemitones 0 ;
    :rootMidi 60 .

:ascendingRoute2 a owl:NamedIndividual,
        :Route ;
    :climbSemitones 2 ;
    :rootMidi 60 .

:ascendingRoute4 a owl:NamedIndividual,
        :Route ;
    :climbSemitones 4 ;
    :rootMidi 60 .

:basicSet a owl:NamedIndividual,
        :Exercise,
        :Set ;
    :durationSeconds 46.0 ;
    :exerciseId "basic_set" ;
    :hasPattern :ascending,
        :descending,
        :threeNotes,
        :triad ;
    :noteCount 23 ;
    :secondsPerNote 2.0 ;
    :title "Основной набор" .

:climbSemitones a owl:DatatypeProperty ;
    rdfs:domain :Route ;
    rdfs:range xsd:integer .

:durationSeconds a owl:DatatypeProperty ;
    rdfs:domain :Exercise ;
    rdfs:range xsd:decimal .

:hasHistory a owl:ObjectProperty ;
    rdfs:domain :Application ;
    rdfs:range :History .

:hasPattern a owl:ObjectProperty ;
    rdfs:domain :Set ;
    rdfs:range :Pattern .

:hasRoute a owl:ObjectProperty ;
    rdfs:domain :Pattern ;
    rdfs:range :Route .

:live a owl:NamedIndividual,
        :LiveMode ;
    rdfs:label "Живой голос"@ru .

:localHistory a owl:NamedIndividual,
        :History ;
    rdfs:comment "Приложение сохраняет результаты в локальный progress.csv; содержимое файла в модель не импортируется."@ru .

:songs a owl:NamedIndividual,
        :SongMode ;
    rdfs:label "Песни, эксперимент"@ru .

:warmup a owl:NamedIndividual,
        :WarmupMode ;
    rdfs:label "Распевки"@ru ;
    :hasExercise :ascending,
        :basicSet,
        :descending,
        :threeNotes,
        :triad .

:ascending a owl:NamedIndividual,
        :Exercise,
        :Pattern ;
    :durationSeconds 10.0 ;
    :exerciseId "ascending" ;
    :hasRoute :ascendingRoute0,
        :ascendingRoute2,
        :ascendingRoute4 ;
    :highestMidi 67 ;
    :lowestMidi 60 ;
    :noteCount 5 ;
    :secondsPerNote 2.0 ;
    :title "Лесенка вверх" .

:descending a owl:NamedIndividual,
        :Exercise,
        :Pattern ;
    :durationSeconds 10.0 ;
    :exerciseId "descending" ;
    :highestMidi 67 ;
    :lowestMidi 60 ;
    :noteCount 5 ;
    :secondsPerNote 2.0 ;
    :title "Лесенка вниз" .

:estimatedDurationSeconds a owl:DatatypeProperty .

:hasExercise a owl:ObjectProperty ;
    rdfs:domain :WarmupMode ;
    rdfs:range :Exercise .

:noteCount a owl:DatatypeProperty ;
    rdfs:domain :Exercise ;
    rdfs:range xsd:integer .

:rootMidi a owl:DatatypeProperty ;
    rdfs:domain :Route ;
    rdfs:range xsd:integer .

:secondsPerNote a owl:DatatypeProperty ;
    rdfs:domain :Exercise ;
    rdfs:range xsd:decimal .

:threeNotes a owl:NamedIndividual,
        :Exercise,
        :Pattern ;
    :durationSeconds 10.0 ;
    :exerciseId "three_notes" ;
    :highestMidi 64 ;
    :lowestMidi 60 ;
    :noteCount 5 ;
    :secondsPerNote 2.0 ;
    :title "Пирамидка" .

:triad a owl:NamedIndividual,
        :Exercise,
        :Pattern ;
    :durationSeconds 10.0 ;
    :exerciseId "triad" ;
    :highestMidi 67 ;
    :lowestMidi 60 ;
    :noteCount 5 ;
    :secondsPerNote 2.0 ;
    :title "Арпеджио" .

:var_actual a swrl:Variable .

:var_d a swrl:Variable .

:var_estimated a swrl:Variable .

:History a owl:Class ;
    rdfs:label "История занятий"@ru .

:Set a owl:Class ;
    rdfs:label "Набор"@ru ;
    rdfs:subClassOf :Exercise .

:Application a owl:Class ;
    rdfs:label "Приложение"@ru .

:Mode a owl:Class ;
    rdfs:label "Режим"@ru .

:WarmupMode a owl:Class ;
    rdfs:label "Режим распевок"@ru ;
    rdfs:subClassOf :Mode .

:var_c a swrl:Variable .

:var_m a swrl:Variable .

:var_n a swrl:Variable .

:var_s a swrl:Variable .

:SuspiciousDescription a owl:Class ;
    rdfs:label "Сомнительное описание"@ru .

:var_r a swrl:Variable .

:Pattern a owl:Class ;
    rdfs:label "Паттерн"@ru ;
    rdfs:subClassOf :Exercise .

:Route a owl:Class ;
    rdfs:label "Маршрут"@ru .

:var_e a swrl:Variable .

:Exercise a owl:Class ;
    rdfs:label "Распевка"@ru .
